# Perfil de execucao da API: dev (local) ou prod
SPRING_PROFILES_ACTIVE=dev

# Banco de dados (Docker Compose)
POSTGRES_DB=tempero_mineiro
POSTGRES_USER=postgres
POSTGRES_PASSWORD=troque-esta-senha

# JWT (obrigatorio, minimo de 32 bytes)
APP_JWT_SECRET=troque-por-uma-chave-forte-com-32-bytes-ou-mais
APP_JWT_EXPIRATION_MS=86400000

# Configuracao de URLs
APP_PUBLIC_BASE_URL=http://localhost:8080
APP_CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:8080

# Recursos sensiveis (dev: true | prod: false)
APP_SEED_ENABLED=true
APP_SWAGGER_ENABLED=true
APP_ALLOW_PUBLIC_REGISTER=true
